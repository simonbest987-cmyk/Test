	column '% Processed1' = if(Extra_Processing[Area]="Cold Saw",LOOKUPVALUE(Product_Costs[cold saw %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Crane Rail",LOOKUPVALUE(Product_Costs[crane rail %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Cathodes",LOOKUPVALUE(Product_Costs[cathode %processed],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Darlington",LOOKUPVALUE(Product_Costs[darlo %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Sidepress",LOOKUPVALUE(Product_Costs[restraight %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]))))))
		isHidden
