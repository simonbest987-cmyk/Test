model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SourceWorkbookUrl","DTA_Workbook","Shift_Dates","T_Delays","T_Rolling_Times","T_Tracking_Account","Dim_Week","Operating_Costs","Product_Costs","Extra_Processing"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Week
ref table _Measures
ref table 'Variance Bridge Steps'
ref table T_Tracking_Account
ref table T_Delays
ref table T_Rolling_Times
ref table Extra_Processing
ref table Operating_Costs
ref table Product_Costs
ref table Shift_Dates
ref table 'Summarised Delays'
ref table 'Summarised Rolling'
ref table 'Summarised Cuts Weight'
ref table 'Summarised Blm Weight'
ref table 'Summarised Prime Weight'
ref table 'Summarised Defects'
