table Calendar
	lineageTag: 1b0d5a3f-93be-46ce-a96f-3ffbae60a33a

	measure 'Pro Rata Cuts Wght1' =
			VAR _currentWeekProduct =
				MAX ( 'Summarised Cuts Weight'[WEEK_ABB Product] )
			VAR _twogroupamount =
				CALCULATE (
					SUM ( 'Summarised Cuts Weight'[Summarised Cuts Wght] ),
					REMOVEFILTERS ( 'Summarised Cuts Weight' ),
					'Summarised Cuts Weight'[WEEK_ABB Product] = _currentWeekProduct
				)
			VAR _singleamount =
				SUM ( 'Summarised Cuts Weight'[Summarised Cuts Wght] )
			RETURN
				DIVIDE ( _singleamount, _twogroupamount )
		formatString: 0%;-0%;0%
		lineageTag: 16d2b2b5-3d47-4c43-90af-1939775173c1

	measure 'Total Delays For Week_ABB Product x Pro Rata Cuts Wght1' =
			
			SUM('Summarised Cuts Weight'[Total Delays For Week_ABB Product]) * [Pro Rata Cuts Wght1]
		formatString: 0.00
		lineageTag: f5976be2-d75f-4361-8361-e99100b192e8

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalMultiplication"
				}

