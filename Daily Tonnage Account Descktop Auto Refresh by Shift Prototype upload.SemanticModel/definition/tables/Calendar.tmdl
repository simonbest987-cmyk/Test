		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalMultiplication"
				}

	measure 'Worked Time1' = ```
			
			 [PR Rolling] - [Total Delays For Week_ABB Product x Pro Rata Cuts Wght1]
			```
		formatString: 0.00
		lineageTag: 15a99b94-49c9-48aa-b5c4-4cbf9458e7cb

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalAddition"
				}

