table 'Summarised Rolling'
	lineageTag: dad95827-580e-40c9-a7e7-66da19ab1315

	measure 'Rolling Time Related' =
			SUM ( 'Summarised Rolling'[Summarised Rolling] )
		lineageTag: 3a3c7a74-9043-4125-9add-1038603c3c60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'WEEK_ABB Product'
		lineageTag: 933ccf4e-d607-465c-ade5-bbb2ec2156b4
		summarizeBy: none
		isNameInferred
		sourceColumn: T_Rolling_Times[WEEK_ABB Product]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isText":true}

	column Week
		formatString: 0
		lineageTag: 2c9348db-75e3-46e9-8df2-7668ecb462eb
		summarizeBy: sum
		isNameInferred
		sourceColumn: T_Rolling_Times[Week]

