		isNameInferred
		sourceColumn: T_Rolling_Times[ABB Week]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Summarised Rolling-e4bc0f2d-36e5-4668-b6f8-83bab9e84c6b' = calculated
		mode: import
		source =
				SUMMARIZE(T_Rolling_Times,T_Rolling_Times[WEEK_ABB Product],T_Rolling_Times[Week],T_Rolling_Times[ABB Week],"Summarised Rolling",sum(T_Rolling_Times[Total Rolling Time])
				)

