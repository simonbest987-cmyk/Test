table Unique_Week
	lineageTag: 6ad9c16d-0cc6-417d-8fe1-109ae2485b7d

	measure 'Worked Time' = ```
			sumx (RELATEDTABLE('Summarised Rolling'),
			[Summarised Rolling]) - sumx (RELATEDTABLE('Summarised Delays'),
			[Summarised Delays])
			
			```
		lineageTag: c22de999-2170-4b8e-8f6c-1227438e895a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avail =
			
			DIVIDE([Worked Time], [Rolling Time Related])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b0040eb9-4d43-4a49-af99-87714440d8bf

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure '42 Yield (A)' =
			
			DIVIDE(
				SUM('Summarised Cuts Weight'[Summarised Cuts Wght]),
				SUM('Summarised Cuts Weight'[Bloom Weight])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3bd8c695-11d8-42c9-a630-589e5b580cce

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure '36 Yield (A)' =
			
			DIVIDE(
				SUM('Summarised Cuts Weight'[H/Saw Weight]),
				SUM('Summarised Cuts Weight'[Summarised Cuts Wght])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f2842b52-50d4-47a0-963e-5a1d56a6779f

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure 'Prime Output' =
			
			SUM('Summarised Cuts Weight'[H/Saw Weight]) + SUM('Summarised Cuts Weight'[Defects])
		formatString: 0.00
		lineageTag: be4bba99-93ae-4890-98f1-77ada471ccd5

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalAddition"
				}

	measure 'Fin Yield (A)' =
			
			DIVIDE([Prime Output], SUM('Summarised Cuts Weight'[H/Saw Weight]))
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fb6e91fa-ac71-4e4a-a92e-726f23b05ad4

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure '42 Yield Stnd Calc' =
			
			DIVIDE(
				SUM('Summarised Cuts Weight'[Standard Cuts Wgt]),
				SUM('Summarised Cuts Weight'[Bloom Weight])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9a96a2eb-1f4b-45d5-aa6f-9c5b25c47563

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure '36 Yield Stnd Calc' =
			
			DIVIDE(
				SUM('Summarised Cuts Weight'[Standard H/Saw Weight]),
				SUM('Summarised Cuts Weight'[Summarised Cuts Wght])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9b64cc6b-052b-4646-a2f4-61b26db47786

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalDivision"
				}

	measure 'Standard Fin Yield Calc' =
			
			DIVIDE(
				SUM('Summarised Cuts Weight'[Standard PrimeWeight]),
				SUM('Summarised Cuts Weight'[H/Saw Weight])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 1eef31bf-9a6e-464d-a3fa-747792cac03f

