table Operating_Costs
	lineageTag: 402bcd43-70c6-417c-9f16-a393b3f4ac66

	measure 'Daily 42 Flexed £' =
			
			CALCULATE(
				SUM('Operating_Costs'[Daily Fixed])+SUM('Operating_Costs'[Daily Depn]),
				'Operating_Costs'[Cost Centre] IN { 303221 }
			)
		formatString: 0.00
		lineageTag: 09adbe5e-0584-48ac-a5a9-99015da40958

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "FilteredMeasure"
				}

	measure 'Weekly 42 Flexed Fixed £' =
			
			CALCULATE(
				SUM('Operating_Costs'[Fixed])+SUM('Operating_Costs'[Depn]),
				'Operating_Costs'[Cost Centre] IN { 303221 }
			)
		lineageTag: 76801296-41f8-4198-b806-874939ba8b24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly 42 Flexed Var £' =
			
			SUM('T_Tracking_Account'[Blm Wght]) * [Weekly 42 Flexed Variable £]
		lineageTag: 5d0d1fe7-7d96-4ee7-9db6-8094999d4ac3

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "MathematicalMultiplication"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly 36 Flexed Fixed £' =
			
			CALCULATE(
				SUM('Operating_Costs'[Fixed])+SUM('Operating_Costs'[Depn]),
				'Operating_Costs'[Cost Centre] IN { 303605 }
			)
		lineageTag: 222caa08-9693-4626-8016-639a18969f6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly 36 Flexed Variable £' =
			
			CALCULATE(
				SUM('Operating_Costs'[tonne var]),
				'Operating_Costs'[Cost Centre] IN { 303605 }
			)
		lineageTag: a126f5e8-382c-4e78-afa3-3bc9b032e708

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Weekly 36 Flexed Var £' =
			
			SUM('T_Tracking_Account'[Cuts Wgt]) * [Weekly 36 Flexed Variable £]
		lineageTag: 04d5e903-d6cb-4251-9345-0d11616a7afa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '42 Flexed Fixed Costs for Period' = [Weekly 42 Flexed Fixed £]*[Count of Week No plus Count of Week No]
