	measure 'Cathode Process Manned Hours' =
			
			CALCULATE(
				SUM('Operating_Costs'[Manned hr]),
				'Operating_Costs'[Cost Centre] IN { 303648 }
			)
		lineageTag: 7708a1d5-b2b8-4684-8a5c-ffd0f02678a9

		extendedProperty MeasureTemplate =
