	column '% Processed' = 'Extra_Processing'[% Processed1]/100
		lineageTag: 6468cfcc-a1f9-4bb7-a6ef-a7401ce35945
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Standard Worked' =
			-- Same values as the original nested IF over the "... Manned Hours" measures, without calling
			-- measures (context transition). Operating_Costs has no relationships, so each was a constant per cost centre.
			VAR _costCentre =
				SWITCH (
					Extra_Processing[Area],
					"Cold Saw", 303662,
					"Crane Rail", 303646,
					"Cathodes", 303648,
					"Darlington", 303666,
					"Sidepress", 303644
				)
			RETURN
				IF (
					NOT ISBLANK ( _costCentre ),
					SUMX ( FILTER ( Operating_Costs, Operating_Costs[Cost Centre] = _costCentre ), Operating_Costs[Manned hr] )
				)
		lineageTag: e5f0e4f7-219a-4e90-baf3-f7ce3de05fd0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Standard Rate' =
			-- Same values as the original nested IF over the "... Process Rate" measures, without calling
			-- measures (context transition). Operating_Costs has no relationships, so each was a constant per cost centre.
			VAR _costCentre =
				SWITCH (
					Extra_Processing[Area],
					"Cold Saw", 303662,
					"Crane Rail", 303646,
					"Cathodes", 303648,
					"Darlington", 303666,
					"Sidepress", 303644
				)
			RETURN
				IF (
					NOT ISBLANK ( _costCentre ),
					SUMX ( FILTER ( Operating_Costs, Operating_Costs[Cost Centre] = _costCentre ), Operating_Costs[fixed wkd hr] )
				)
		lineageTag: d3a6bd94-c2db-424c-ada4-a4cd7550b418
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Activity = ('Extra_Processing'[Standard Worked]-'Extra_Processing'[Total Time])*'Extra_Processing'[Standard Rate]
		lineageTag: bf16290c-c1e4-49b6-952d-c3ee44a9ab00
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

