	column '% Processed1' = if(Extra_Processing[Area]="Cold Saw",LOOKUPVALUE(Product_Costs[cold saw %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Crane Rail",LOOKUPVALUE(Product_Costs[crane rail %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Cathodes",LOOKUPVALUE(Product_Costs[cathode %processed],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Darlington",LOOKUPVALUE(Product_Costs[darlo %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Sidepress",LOOKUPVALUE(Product_Costs[restraight %process],Product_Costs[Product Code],'Extra_Processing'[Product Code]))))))
		lineageTag: ee6944c0-0144-4b74-8cff-f468abdf8303
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Extra Process Cost' = if(Extra_Processing[Area]="Cold Saw",LOOKUPVALUE(Product_Costs[cold saw tot],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Crane Rail",LOOKUPVALUE(Product_Costs[crane rail tot],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Cathodes",LOOKUPVALUE(Product_Costs[cathode tot],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Darlington",LOOKUPVALUE(Product_Costs[darlo tot],Product_Costs[Product Code],'Extra_Processing'[Product Code]),if(Extra_Processing[Area]="Sidepress",LOOKUPVALUE(Product_Costs[restraight tot],Product_Costs[Product Code],'Extra_Processing'[Product Code]))))))
		lineageTag: 6dde8a5f-1984-415d-8615-bba61ea06e54
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column OSP = ([Tonnes]*[Extra Process Cost])/'Extra_Processing'[% Processed]
		lineageTag: 28635d91-49e5-4230-b315-397b1b2e0e83
		summarizeBy: sum

