	partition Fact_Delays = m
		mode: import
		source =
				let
				    Source = fnExportSheet("Delays"),
				    Kept = Table.SelectColumns(Source, {"Start", "End", "type", "prod", "roll", "area", "subarea", "location", "cause", "comments", "Source File", "Source File Modified"}, MissingField.UseNull),
				    Times = Table.TransformColumns(Kept, {{"Start", fnToDateTime, type nullable datetime}, {"End", fnToDateTime, type nullable datetime}}),
				    Typed = Table.TransformColumnTypes(Times, {{"type", type text}, {"prod", type text}, {"roll", type text}, {"area", type text}, {"subarea", type text}, {"location", type text}, {"cause", type text}, {"comments", type text}}, "en-GB"),
				    Valid = Table.SelectRows(Typed, each [Start] <> null),
				    // Each export repeats the week to date; keep one row per event, taking the latest file (most up-to-date End)
				    Latest = Table.Buffer(Table.Sort(Valid, {{"Source File Modified", Order.Descending}, {"End", Order.Descending}})),
				    Dedup = Table.Distinct(Latest, {"Start", "prod", "area", "location"}),
				    Ordered = Table.Sort(Dedup, {{"Start", Order.Ascending}}),
				    WithId = Table.AddIndexColumn(Ordered, "Delay ID", 1, 1, Int64.Type),
				    ProductKey = Table.AddColumn(WithId, "Product Key", each if [prod] = null then null else Text.TrimEnd([prod]), type nullable text),
				    Split = fnSplitByOperationalDay(ProductKey, "Start", "End"),
				    Final = Table.TransformColumnTypes(Split, {{"Operational Date", type date}, {"Segment Start", type datetime}, {"Segment End", type datetime}, {"Hours", type number}})
				in
				    Final

	annotation PBI_ResultType = Table
