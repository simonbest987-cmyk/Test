		summarizeBy: none
		sourceColumn: Hours

		annotation SummarizationSetBy = Automatic

	partition Fact_Speed = m
		mode: import
		source =
				let
				    Source = fnExportSheet("Speed Feedback"),
				    Kept = Table.SelectColumns(Source, {"Start", "End", "prod", "roll", "speed", "target_speed", "reason", "comments", "Source File", "Source File Modified"}, MissingField.UseNull),
				    Times = Table.TransformColumns(Kept, {{"Start", fnToDateTime, type nullable datetime}, {"End", fnToDateTime, type nullable datetime}}),
				    Typed = Table.TransformColumnTypes(Times, {{"prod", type text}, {"roll", type text}, {"reason", type text}, {"comments", type text}, {"speed", type number}, {"target_speed", type number}}, "en-GB"),
				    Valid = Table.SelectRows(Typed, each [Start] <> null),
				    // Each export repeats the week to date; keep one row per event, taking the latest file (most up-to-date End)
				    Latest = Table.Buffer(Table.Sort(Valid, {{"Source File Modified", Order.Descending}, {"End", Order.Descending}})),
				    Dedup = Table.Distinct(Latest, {"Start", "prod", "roll"}),
				    Ordered = Table.Sort(Dedup, {{"Start", Order.Ascending}}),
				    ProductKey = Table.AddColumn(Ordered, "Product Key", each if [prod] = null then null else Text.TrimEnd([prod]), type nullable text),
				    Split = fnSplitByOperationalDay(ProductKey, "Start", "End"),
				    Final = Table.TransformColumnTypes(Split, {{"Operational Date", type date}, {"Segment Start", type datetime}, {"Segment End", type datetime}, {"Hours", type number}})
				in
				    Final

	annotation PBI_ResultType = Table
