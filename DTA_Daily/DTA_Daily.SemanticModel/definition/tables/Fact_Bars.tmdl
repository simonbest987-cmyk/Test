		sourceColumn: Source File Modified

		annotation SummarizationSetBy = Automatic

	partition Fact_Bars = m
		mode: import
		source =
				let
				    Source = fnExportSheet("Tonnage Account"),
				    // The export ends with a totals row that has no Product Code
				    Bars = Table.SelectRows(Source, each [Product Code] <> null and Text.Trim(Text.From([Product Code])) <> ""),
				    SawTime = Table.AddColumn(Bars, "Saw Time", each fnToDateTime([Time at Saw1]), type nullable datetime),
				    Shift = Table.AddColumn(SawTime, "Shift", each
				        let t = if [Time at Saw1] = null then "" else Text.From([Time at Saw1])
				        in if Text.Length(t) > 20 then Text.Trim(Text.Range(t, 20)) else null, type nullable text),
				    // Operational day boundary is 07:00
				    OpDate = Table.AddColumn(Shift, "Operational Date", each if [Saw Time] = null then null else Date.From([Saw Time] - #duration(0, 7, 0, 0)), type nullable date),
				    ProductKey = Table.AddColumn(OpDate, "Product Key", each Text.TrimEnd(Text.From([Product Code])), type text),
				    Kept = Table.SelectColumns(ProductKey, {"Product Key", "Product Code", "Rolling", "group descr", "product", "Cast", "Piece1", "Quality", "Saw Time", "Shift", "Operational Date", "Blm Wght", "Cuts Wgt", "Prime", "Cuts", "Order", "Customer", "Bloom_input", "42_mill_throput", "42_mill_Yield", "42_mill_Scrap", "scrap_cost_per_tonne", "42_mill_Scale", "Scale_cost_tonne", "42_mill_run_tot", "42_mill_roll_tarif", "36_mill_throput", "36_mill_yield", "36_mill_scrap", "36_mill_scale", "36_mill_roll_tarif", "test_fees", "product_cost_total", "darlo_tot", "cold_saw_tot", "restraight_tot", "cathode_tot", "crane_rail_tot", "defect", "fin_yield", "Source File", "Source File Modified"}, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Kept, {{"Product Code", type text}, {"Rolling", type text}, {"group descr", type text}, {"product", Int64.Type}, {"Cast", type text}, {"Piece1", type text}, {"Quality", Int64.Type}, {"Shift", type text}, {"Blm Wght", type number}, {"Cuts Wgt", type number}, {"Prime", type number}, {"Cuts", Int64.Type}, {"Order", Int64.Type}, {"Customer", type text}, {"Bloom_input", type number}, {"42_mill_throput", type number}, {"42_mill_Yield", type number}, {"42_mill_Scrap", type number}, {"scrap_cost_per_tonne", type number}, {"42_mill_Scale", type number}, {"Scale_cost_tonne", type number}, {"42_mill_run_tot", type number}, {"42_mill_roll_tarif", type number}, {"36_mill_throput", type number}, {"36_mill_yield", type number}, {"36_mill_scrap", type number}, {"36_mill_scale", type number}, {"36_mill_roll_tarif", type number}, {"test_fees", type number}, {"product_cost_total", type number}, {"darlo_tot", type number}, {"cold_saw_tot", type number}, {"restraight_tot", type number}, {"cathode_tot", type number}, {"crane_rail_tot", type number}, {"defect", type number}, {"fin_yield", type number}, {"Source File", type text}}, "en-GB"),
				    // A bar re-exported in a later file is kept once (latest file wins)
				    Latest = Table.Buffer(Table.Sort(Typed, {{"Source File Modified", Order.Descending}})),
				    Dedup = Table.Distinct(Latest, {"Cast", "Piece1", "Saw Time"})
				in
				    Dedup

	annotation PBI_ResultType = Table
